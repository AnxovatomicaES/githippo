{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v githippo >/dev/null 2>&1 && githippo hook precompact || true",
            "timeout": 20
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v githippo >/dev/null 2>&1 && githippo hook postcompact || true",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v githippo >/dev/null 2>&1 && githippo hook session-start || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v githippo >/dev/null 2>&1 && githippo hook session-end || true",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v githippo >/dev/null 2>&1 && githippo hook prompt || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
