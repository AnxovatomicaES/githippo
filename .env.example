# Required
GITHUB_TOKEN=github_pat_...        # fine-grained, ONLY your memory repo, Contents: read/write
MEMORY_REPO=you/my-memory          # keep it PRIVATE
MCP_SECRET=                        # remote mode only: openssl rand -hex 32

# Optional
MEMORY_BRANCH=main
MEMORY_ROOT=memory
EMBEDDINGS=local                   # local | voyage | none
LOCAL_EMBED_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2   # see docs/calibration.md
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
ANTHROPIC_API_KEY=                 # only for: maintain rewrite=<path>
ANTHROPIC_MODEL=claude-sonnet-5-5
CORE_BUDGET_TOKENS=400             # cap for pinned core memory
PROMPT_RECALL=1                    # 0 disables the per-prompt recall hook
GITHIPPO_HOOK_PROFILE=standard     # minimal = only compaction save/restore
GITHIPPO_DISABLED_HOOKS=           # e.g. prompt,steer,drift,startup-note,postcompact,session-end
DECAY_ACTIVE_DAYS=20               # active days before inbox facts / checkpoints are decay candidates
CACHE_DIR=~/.githippo/cache            # ~ is expanded
PORT=8787
