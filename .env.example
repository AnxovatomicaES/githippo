# Required
GITHUB_TOKEN=github_pat_...        # fine-grained, ONLY your memory repo, Contents: read/write
MEMORY_REPO=you/my-memory          # keep it PRIVATE
MCP_SECRET=                        # remote mode only: openssl rand -hex 32

# Optional
MEMORY_BRANCH=main
MEMORY_ROOT=memory
EMBEDDINGS=local                   # local | voyage | none
LOCAL_EMBED_MODEL=Xenova/multilingual-e5-small
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
ANTHROPIC_API_KEY=                 # only for: maintain rewrite=<path>
ANTHROPIC_MODEL=claude-sonnet-5-5
CORE_BUDGET_TOKENS=400             # cap for pinned core memory
PROMPT_RECALL=1                    # 0 disables the per-prompt recall hook
CACHE_DIR=~/.githippo/cache
PORT=8787
